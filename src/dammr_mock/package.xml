<?xml version="1.0" ?>
<package format="3">
  <name>dammr_mock</name>
  <version>0.0.1</version>
  <description>
    Mock configuration of the dual arm mobile manipulator robot (DAMMR): a
    mecanum base, a vertical spine, two arms with grippers, and head, wrist and
    base sensors
  </description>

  <maintainer email="support@picknik.ai">MoveIt Pro User</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>example_arm_description</exec_depend>
  <exec_depend>example_arm_hardware_interface</exec_depend>
  <exec_depend>force_torque_sensor_broadcaster</exec_depend>
  <exec_depend>gripper_controllers</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_admittance_controller</exec_depend>
  <exec_depend>joint_velocity_controller</exec_depend>
  <exec_depend>moveit_pro_behavior</exec_depend>
  <exec_depend>moveit_pro_objectives</exec_depend>
  <exec_depend>moveit_studio_agent</exec_depend>
  <exec_depend>pose_ik</exec_depend>
  <exec_depend>velocity_force_controller</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
