<?xml version="1.0"?>
<!--
  Dual arm mobile manipulator robot (DAMMR): a four-wheel mecanum base with a vertical spine. One spine carriage carries
  two six-axis arms, each with a parallel-jaw gripper and a wrist camera, and a head camera that looks down at the arm
  workspace. Two lidars sit on opposite corners of the base.
-->
<robot name="dammr" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Only "mock" is implemented. -->
  <xacro:arg name="hardware_interface" default="mock"/>
  <xacro:unless value="${'$(arg hardware_interface)' == 'mock'}">
    ${xacro.fatal("dammr.urdf.xacro: hardware_interface '$(arg hardware_interface)' is not supported; use 'mock'.")}
  </xacro:unless>

  <material name="dammr_black">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>
  <material name="dammr_dark_gray">
    <color rgba="0.22 0.23 0.25 1.0"/>
  </material>
  <material name="dammr_light_gray">
    <color rgba="0.72 0.74 0.77 1.0"/>
  </material>
  <material name="dammr_accent">
    <color rgba="0.95 0.55 0.15 1.0"/>
  </material>

  <xacro:include filename="$(find dammr_mock)/urdf/dammr_sensors.xacro"/>
  <xacro:include filename="$(find dammr_mock)/urdf/dammr_virtual_base_joints.xacro"/>
  <xacro:include filename="$(find dammr_mock)/urdf/dammr_base.xacro"/>
  <xacro:include filename="$(find dammr_mock)/urdf/dammr_spine.xacro"/>
  <xacro:include filename="$(find dammr_mock)/urdf/dammr_gripper.xacro"/>
  <xacro:include filename="$(find example_arm_description)/urdf/r6bot_urdf_macro.xacro"/>

  <link name="world"/>
  <xacro:dammr_virtual_base_joints parent="world" child="base_link" height="${wheel_radius}"/>
  <xacro:dammr_base/>

  <!-- The spine stands near the rear of the deck, so the arms reaching forward keep the load over the wheelbase. -->
  <xacro:dammr_spine parent="base_link">
    <origin xyz="${-base_length / 2 + column_depth / 2 + 0.04} 0 ${deck_top}" rpy="0 0 0"/>
  </xacro:dammr_spine>

  <!--
    Each arm stands on the carriage with its base facing up. The arm reaches along its own +y at zero joint angles, so
    a -90 degree yaw points that reach forward. Each upper arm sits up to 0.35 m to one side of its base axis, so the
    right arm is the mirror image of the left and both upper arms sit outboard; the same joint values put the two arms
    in mirror-image poses. The right gripper is turned half a turn so that its wrist camera mirrors the left one.
  -->
  <xacro:macro name="dammr_arm" params="side y mirror gripper_yaw">
    <xacro:r6bot_description prefix="${side}_" mirror="${mirror}"/>
    <joint name="${side}_arm_mount_joint" type="fixed">
      <parent link="spine_carriage_link"/>
      <child link="${side}_base_link"/>
      <origin xyz="${arm_mount_x} ${y} ${carriage_top}" rpy="0 0 ${-pi/2}"/>
    </joint>
    <xacro:dammr_gripper prefix="${side}_" parent="${side}_tool0" yaw="${gripper_yaw}"/>
  </xacro:macro>
  <xacro:dammr_arm side="left" y="${arm_mount_y}" mirror="false" gripper_yaw="0"/>
  <xacro:dammr_arm side="right" y="${-arm_mount_y}" mirror="true" gripper_yaw="${pi}"/>

  <xacro:if value="${'$(arg hardware_interface)' == 'mock'}">
    <xacro:include filename="$(find dammr_mock)/urdf/dammr_mock_ros2_control.xacro"/>
    <xacro:dammr_platform_mock_control/>
    <xacro:include filename="$(find example_arm_hardware_interface)/urdf/r6bot_mock_ros2_control_macro.xacro"/>
    <xacro:r6bot_control prefix="left_"/>
    <xacro:r6bot_control prefix="right_"/>
    <xacro:dammr_gripper_mock_control prefix="left_"/>
    <xacro:dammr_gripper_mock_control prefix="right_"/>
  </xacro:if>

</robot>
