<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    Rectangular four-wheel mecanum base. The base_link origin is the center of the four wheel axles, so it sits
    wheel_radius above the floor. Every wheel joint is continuous with its axis along +y.
  -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.08"/>
  <xacro:property name="half_wheelbase" value="0.28"/>
  <xacro:property name="half_track" value="0.26"/>
  <xacro:property name="base_length" value="0.80"/>
  <xacro:property name="base_width" value="0.60"/>
  <!-- Top of the deck plate, relative to base_link. -->
  <xacro:property name="deck_top" value="0.20"/>

  <xacro:macro name="dammr_mecanum_wheel" params="name x y">
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="100.0" velocity="20.0"/>
    </joint>
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dammr_black"/>
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius * 0.55}" length="${wheel_width + 0.004}"/>
        </geometry>
        <material name="dammr_light_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="dammr_base">
    <link name="base_link">
      <!-- Lower chassis, between the wheels. -->
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${2 * (half_track - wheel_width / 2) - 0.02} 0.18"/>
        </geometry>
        <material name="dammr_dark_gray"/>
      </visual>
      <!-- Deck plate over the wheels. -->
      <visual>
        <origin xyz="0 0 ${deck_top - 0.04}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} 0.08"/>
        </geometry>
        <material name="dammr_light_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${2 * (half_track - wheel_width / 2) - 0.02} 0.18"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 ${deck_top - 0.04}" rpy="0 0 0"/>
        <geometry>
          <box size="${base_length} ${base_width} 0.08"/>
        </geometry>
      </collision>
    </link>

    <xacro:dammr_mecanum_wheel name="front_left_wheel" x="${half_wheelbase}" y="${half_track}"/>
    <xacro:dammr_mecanum_wheel name="rear_left_wheel" x="${-half_wheelbase}" y="${half_track}"/>
    <xacro:dammr_mecanum_wheel name="rear_right_wheel" x="${-half_wheelbase}" y="${-half_track}"/>
    <xacro:dammr_mecanum_wheel name="front_right_wheel" x="${half_wheelbase}" y="${-half_track}"/>

    <!-- Two lidars on opposite deck corners, each facing diagonally outward. -->
    <xacro:dammr_2d_lidar name="front_left_lidar" parent="base_link">
      <origin xyz="${base_length / 2 - 0.04} ${base_width / 2 - 0.04} ${deck_top + 0.03}" rpy="0 0 ${pi/4}"/>
    </xacro:dammr_2d_lidar>
    <xacro:dammr_2d_lidar name="rear_right_lidar" parent="base_link">
      <origin xyz="${-base_length / 2 + 0.04} ${-base_width / 2 + 0.04} ${deck_top + 0.03}" rpy="0 0 ${-3 * pi/4}"/>
    </xacro:dammr_2d_lidar>
  </xacro:macro>

</robot>
